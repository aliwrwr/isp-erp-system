PORT=3000
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Choose ONE of these database modes:
# 1) PostgreSQL for cloud deployment (recommended for Vercel/Render/Railway)
DATABASE_URL=postgresql://user:password@host:5432/isp_erp
DATABASE_SSL=false

# 2) SQLite for local development
SQLITE_PATH=isp-erp.sqlite

# Frontend URL used by backend CORS
FRONTEND_URL=http://localhost:5173
